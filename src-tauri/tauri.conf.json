{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "playerWCY",
  "version": "1.7.1",
  "identifier": "com.wcy.playerwcy",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "playerWCY",
        "width": 1180,
        "height": 760,
        "minWidth": 880,
        "minHeight": 560,
        "useHttpsScheme": true
      }
    ],
    "security": {
      "assetProtocol": {
        "enable": true,
        "scope": [
          "**"
        ]
      },
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "copyright": "Copyright (c) 2026 alanwangcanyi",
    "targets": [
      "app",
      "dmg"
    ],
    "macOS": {},
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.png"
    ]
  }
}
